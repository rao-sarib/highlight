# ─────────────────────────────────────────────────────────────────────────
# Production environment variables.
#
# On your server: copy this file to ".env" (same folder as docker-compose.prod.yml)
# and fill in your real keys. Docker Compose loads ".env" automatically.
#
#   cp .env.prod.example .env
#   nano .env        # paste your keys, save with Ctrl+O then Ctrl+X
#
# NEVER commit your real ".env" to GitHub — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED — your own paid OpenAI key (powers all AI features)
OPENAI_API_KEY=sk-your-real-key-here

# OPTIONAL — enhances Competitor Benchmarking with real Google SERP ranks
SERPER_API_KEY=

# OPTIONAL — enables AI Visibility citation scoring
PERPLEXITY_API_KEY=

# RECOMMENDED — change this to a long random string for production
SECRET_KEY=change-me-to-a-long-random-string
