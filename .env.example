# ══════════════════════════════════════════════════════════════════════════
#  HIGHLIGHT AI SEO Tool — Environment Variables Reference
#  Copy this file to:
#    • .env                (root — used by docker-compose to substitute vars)
#    • backend/.env        (used by FastAPI / uvicorn in local dev)
#    • frontend/.env.local (used by Next.js in local dev)
# ══════════════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL + pgvector) ──────────────────────────────────────
# Local dev: port 5433 (mapped in docker-compose to avoid clash with system PG)
# Docker:    port 5432  (internal container network)
DATABASE_URL=postgresql://admin:password@localhost:5433/highlight_seo

# ── Redis (optional — used for task queuing) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ─────────────────────────────────────────────────────
# CHANGE THIS in production — use a long random string
SECRET_KEY=super-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── OpenAI API  ────────────────────────────────────────────────────────────
# REQUIRED for: Prompt Optimization, Content Generation, SEO Fixes,
#               AI Visibility fallback, Backlinks outreach email, Embeddings
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Serper API  ────────────────────────────────────────────────────────────
# REQUIRED for: Competitor Benchmarking (real Google SERP rankings).
# Without this key the features still work via web-scraping + keyword density.
# Free tier: 2,500 queries/month  |  Get key at: https://serper.dev
SERPER_API_KEY=

# ── SerpApi  ───────────────────────────────────────────────────────────────
# REQUIRED for: the "Google AI Overview" engine (AI Visibility / GEO) — checks
#               whether your site is cited in Google's AI Overview. Serper does
#               NOT expose AI Overviews, so this uses SerpApi instead. If unset,
#               the Google AI Overview engine is simply hidden (no zero scores).
# Free tier: 100 searches/month  |  Get key at: https://serpapi.com
SERPAPI_API_KEY=

# ── Perplexity API  ────────────────────────────────────────────────────────
# REQUIRED for: AI Visibility (GEO) — live AI Share-of-Voice scans.
# Each scan asks several brand-neutral buyer questions to the live engine and
# detects whether your domain/brand is cited in the answers. Scans are cached
# for 24h per (project, keyword) and answers are token-capped, so credit usage
# stays low (~$0.02 per 4-prompt scan on the "sonar" model).
# Get key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── Google Gemini API (optional) ───────────────────────────────────────────
# OPTIONAL — adds Gemini (with Google Search grounding) as an extra AI-visibility
# engine in AI Visibility (GEO) and the Full Analysis report. When set, scans
# query Gemini alongside Perplexity / ChatGPT / Google AI Overview and report a
# per-engine citation breakdown. Leave blank to skip Gemini.
# Free tier available  |  Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Stripe (payments) ──────────────────────────────────────────────────────
# Powers buying a package (Pro / Pro+ / Enterprise) via hosted Checkout.
# For the demo all packages are $0, so the app uses a "test activation" button
# that bypasses payment — Stripe keys are only needed for REAL checkout.
#   STRIPE_SECRET_KEY      — sk_test_… (test mode) from the Stripe dashboard
#   STRIPE_WEBHOOK_SECRET  — whsec_… (run `stripe listen` or create a webhook
#                            endpoint -> /api/v1/billing/webhook to get this)
#   STRIPE_PUBLISHABLE_KEY — pk_test_… (only needed for a custom card form)
#   FRONTEND_BASE_URL      — where Stripe redirects back after checkout
# Get keys at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
FRONTEND_BASE_URL=http://localhost:3000

# ── Admin panel (/adminpanel) ──────────────────────────────────────────────
# Credentials for the separate site admin panel (CMS, SMTP, RBAC). Seeded into
# the database on first startup if no admin exists. Change after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=highlight-admin

# ── Temporal Workflow Engine  ──────────────────────────────────────────────
# REQUIRED for: Content Generation, SEO Fixes, Content Refresh
# Start with: docker-compose up temporal  (or docker-compose up for full stack)
TEMPORAL_SERVER_URL=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=highlight-seo-task-queue

# ── Google Analytics 4 Data API (optional) ─────────────────────────────────
# OPTIONAL — enables real GA4 traffic charts on the Analytics page.
# Without this, Analytics still shows real content/embedding metrics from
# our own database (always available, no setup needed).
#
# One-time setup:
#   1. In Google Cloud Console, create a project and a Service Account.
#   2. Enable the "Google Analytics Data API" for that project.
#   3. Create a JSON key for the service account and save it inside backend/
#      (e.g. backend/ga4-service-account.json). This file is gitignored.
#   4. Set GA4_SERVICE_ACCOUNT_FILE below to that filename.
# Per-website (done by each end user from the Analytics page UI):
#   - Add the service account's email as a "Viewer" in their GA4 property
#     (Admin -> Property Access Management), then enter their numeric GA4
#     Property ID in the app. This step is optional and can be skipped.
GA4_SERVICE_ACCOUNT_FILE=

# ══════════════════════════════════════════════════════════════════════════
#  frontend/.env.local (Next.js)
# ══════════════════════════════════════════════════════════════════════════
# Points the browser at the FastAPI backend.
# Local dev: http://127.0.0.1:8000/api/v1
# Docker:    http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# ══════════════════════════════════════════════════════════════════════════
#  FEATURE AVAILABILITY SUMMARY
#  (what works with / without each key)
# ══════════════════════════════════════════════════════════════════════════
#
#  Feature                   | OPENAI | SERPER | PERPLEXITY | TEMPORAL
#  --------------------------+--------+--------+------------+---------
#  User auth / projects      |   —    |   —    |     —      |    —
#  Prompt Optimization       |  REQ   |   —    |     —      |    —
#  Content Generation        |  REQ   |   —    |     —      |   REQ
#    (incl. GEO content type)|  REQ   |   —    |     —      |   REQ
#  SEO Fixes (audit)         |  REQ   |   —    |     —      |   REQ
#  Content Refresh           |  REQ   |   —    |     —      |   REQ
#  AI Visibility / GEO scan  |  REQ   |   opt  |    REQ     |    —
#    + Gemini engine         |  set GEMINI_API_KEY (optional)
#    + Google AI Overview    |  set SERPAPI_API_KEY (optional)
#  Competitor Benchmarking   |   —    |   opt  |     —      |    —
#    + SERP rankings         |   —    |   REQ  |     —      |    —
#  Backlinks + email         |  REQ   |   opt  |     —      |    —
#    (SERP-based prospects)  |  REQ   |   REQ  |     —      |    —
#  LSI / semantic keywords   |  REQ   |   —    |     —      |    —
#  Analytics                 |   —    |   —    |     —      |    —
#
#  REQ = required for this feature to work
#  opt = optional — feature works without it but is enhanced with it
#   —  = not used by this feature
