# Production build env (Netlify + Vercel).
#
# Call the backend through a RELATIVE path so each host's proxy forwards
# /api/* to the FastAPI backend on EC2 (avoids CORS + mixed-content, keeps the
# backend IP out of the client bundle):
#   • Netlify → proxy in netlify.toml
#   • Vercel  → proxy in frontend/vercel.json
#
# Not read by `next dev` (local keeps using http://127.0.0.1:8000/api/v1).
NEXT_PUBLIC_API_BASE_URL=/api/v1
