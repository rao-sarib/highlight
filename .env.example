# ══════════════════════════════════════════════════════════════════════════
#  HIGHLIGHT AI SEO Tool — Environment Variables Reference
#  Copy this file to:
#    • .env                (root — used by docker-compose to substitute vars)
#    • backend/.env        (used by FastAPI / uvicorn in local dev)
#    • frontend/.env.local (used by Next.js in local dev)
# ══════════════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL + pgvector) ──────────────────────────────────────
# Local dev: port 5433 (mapped in docker-compose to avoid clash with system PG)
# Docker:    port 5432  (internal container network)
DATABASE_URL=postgresql://admin:password@localhost:5433/highlight_seo

# ── Redis (optional — used for task queuing) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ─────────────────────────────────────────────────────
# CHANGE THIS in production — use a long random string
SECRET_KEY=super-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── OpenAI API  ────────────────────────────────────────────────────────────
# REQUIRED for: Prompt Optimization, Content Generation, SEO Fixes,
#               AI Visibility fallback, Backlinks outreach email, Embeddings
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Serper API  ────────────────────────────────────────────────────────────
# REQUIRED for: Competitor Benchmarking (real Google SERP rankings)
# Without this key the feature still works using web-scraping + keyword density.
# With this key you additionally get: competitor SERP rank, top-10 organic results.
# Free tier: 2,500 queries/month  |  Get key at: https://serper.dev
SERPER_API_KEY=

# ── Perplexity API  ────────────────────────────────────────────────────────
# REQUIRED for: AI Visibility — citation-based scoring
# Without this key the feature still works via OpenAI cosine-similarity fallback.
# With this key: checks whether your site URL is cited in Perplexity's live answers.
# Get key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── Temporal Workflow Engine  ──────────────────────────────────────────────
# REQUIRED for: Content Generation, SEO Fixes, Content Refresh
# Start with: docker-compose up temporal  (or docker-compose up for full stack)
TEMPORAL_SERVER_URL=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=highlight-seo-task-queue

# ── Google Analytics 4 Data API (optional) ─────────────────────────────────
# OPTIONAL — enables real GA4 traffic charts on the Analytics page.
# Without this, Analytics still shows real content/embedding metrics from
# our own database (always available, no setup needed).
#
# One-time setup:
#   1. In Google Cloud Console, create a project and a Service Account.
#   2. Enable the "Google Analytics Data API" for that project.
#   3. Create a JSON key for the service account and save it inside backend/
#      (e.g. backend/ga4-service-account.json). This file is gitignored.
#   4. Set GA4_SERVICE_ACCOUNT_FILE below to that filename.
# Per-website (done by each end user from the Analytics page UI):
#   - Add the service account's email as a "Viewer" in their GA4 property
#     (Admin -> Property Access Management), then enter their numeric GA4
#     Property ID in the app. This step is optional and can be skipped.
GA4_SERVICE_ACCOUNT_FILE=

# ══════════════════════════════════════════════════════════════════════════
#  frontend/.env.local (Next.js)
# ══════════════════════════════════════════════════════════════════════════
# Points the browser at the FastAPI backend.
# Local dev: http://127.0.0.1:8000/api/v1
# Docker:    http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# ══════════════════════════════════════════════════════════════════════════
#  FEATURE AVAILABILITY SUMMARY
#  (what works with / without each key)
# ══════════════════════════════════════════════════════════════════════════
#
#  Feature                   | OPENAI | SERPER | PERPLEXITY | TEMPORAL
#  --------------------------+--------+--------+------------+---------
#  User auth / projects      |   —    |   —    |     —      |    —
#  Prompt Optimization       |  REQ   |   —    |     —      |    —
#  Content Generation        |  REQ   |   —    |     —      |   REQ
#  SEO Fixes (audit)         |  REQ   |   —    |     —      |   REQ
#  Content Refresh           |  REQ   |   —    |     —      |   REQ
#  AI Visibility (Perplexity)|   opt  |   —    |    REQ     |    —
#  AI Visibility (fallback)  |  REQ   |   —    |     —      |    —
#  Competitor Benchmarking   |   —    |   opt  |     —      |    —
#    + SERP rankings         |   —    |   REQ  |     —      |    —
#  Backlinks + email         |  REQ   |   —    |     —      |    —
#  LSI Keywords              |   —    |   —    |     —      |    —
#  Analytics                 |   —    |   —    |     —      |    —
#
#  REQ = required for this feature to work
#  opt = optional — feature works without it but is enhanced with it
#   —  = not used by this feature
